; Engine configuration file for the Godot 4.7.2 port (see docs/knowledge/16-godot-architecture.md).
; Hand-edited settings are commented in note 16; the editor may reorder this file.
config_version=5

[application]

config/name="天岸"
config/description="天岸 (working title). Godot 4.7.2 port, P1 foundation."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.039, 0.035, 0.05, 1)
run/flush_stdout_on_print=true
config/quit_on_go_back=false

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Save="*res://core/save.gd"
GameState="*res://core/game_state.gd"
Audio="*res://core/audio.gd"
InputRouter="*res://core/input_router.gd"
DebugBridge="*res://core/debug_bridge.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[gui]

common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/include_text_server_data=true
locale/line_breaking_strictness=3

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.035, 0.05, 1)
