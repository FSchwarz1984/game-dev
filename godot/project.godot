; Engine configuration file for the Godot 4.7.2 port (see docs/knowledge/16-godot-architecture.md).
; Hand-edited settings are commented in note 16; the editor may reorder this file.
config_version=5

[application]

config/name="天岸"
config/description="天岸 (working title). Godot 4.7.2 port, P1 foundation."
run/main_scene="res://main.tscn"
run/main_scene.showcase="res://showcase/showcase.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.039, 0.035, 0.05, 1)
run/flush_stdout_on_print=true
config/quit_on_go_back=false

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Save="*res://core/save.gd"
GameState="*res://core/game_state.gd"
Audio="*res://core/audio.gd"
InputRouter="*res://core/input_router.gd"
DebugBridge="*res://core/debug_bridge.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[gui]

common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/include_text_server_data=true
locale/line_breaking_strictness=3

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.035, 0.05, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/16_bits=false
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128

[shader_globals]

w3_view={
"type": "vec4",
"value": Vector4(30, 0.819152, 0.573576, 0.520567)
}
w3_time={
"type": "float",
"value": 0.0
}
w3_sun_dir={
"type": "vec3",
"value": Vector3(-0.45, 0.77, -0.45)
}
w3_sun={
"type": "vec3",
"value": Vector3(1, 0.95, 0.85)
}
w3_sky={
"type": "vec3",
"value": Vector3(0.36, 0.42, 0.52)
}
w3_ground={
"type": "vec3",
"value": Vector3(0.16, 0.14, 0.11)
}
w3_shade_tint={
"type": "vec3",
"value": Vector3(0.92, 0.97, 1.08)
}
w3_lit_tint={
"type": "vec3",
"value": Vector3(1.04, 1.0, 0.94)
}
w3_wind={
"type": "vec4",
"value": Vector4(1, 0.2, 1, 0.3)
}
w3_wet={
"type": "float",
"value": 0.0
}
w3_player={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}
w3_night={
"type": "float",
"value": 0.0
}
w3_lamps={
"type": "sampler2D",
"value": ""
}
w3_lamp_n={
"type": "float",
"value": 0.0
}
w3_bake={
"type": "float",
"value": 0.0
}
w3_fog_col={
"type": "vec3",
"value": Vector3(0.6, 0.66, 0.72)
}
w3_mist={
"type": "vec4",
"value": Vector4(-20, -40, 0, 0.01)
}
w3_haze={
"type": "vec4",
"value": Vector4(0, 8, 40, 0.9)
}
