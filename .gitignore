# Godot: editor cache and local exports (never committed)
godot/.godot/
godot/export/

# Generator intermediates (rebuilt by tools/terrain and tools/flora); finished assets live in godot/
tools/terrain/out/
tools/flora/out/

# vista generator intermediates (finished assets live in godot/vista)
tools/vista/out/

# props generator intermediates (finished assets live in godot/art/props)
tools/props/out/

# 3D asset generator intermediates (rebuilt by tools/world3d_assets); finished assets live in godot/world3d/assets
tools/world3d_assets/out/

# 3D terrain generator intermediates (rebuilt by tools/world3d); finished data lives in godot/world3d
tools/world3d/out/

# Village blueprint renders while the design is in progress (regenerated by tools/design/village_plan.py from the registry);
